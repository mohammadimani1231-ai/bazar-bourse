# === Supabase — خوانده‌شده توسط Next.js در زمان اجرا ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# فقط سمت سرور — هرگز در باندل کلاینت یا git قرار نگیرد
SUPABASE_SERVICE_ROLE_KEY=

# === Supabase CLI — برای supabase link / db push / functions deploy ===
# در .env.local لازم نیست؛ می‌توانی مستقیم به CLI بدهی یا در پروفایل شل export کنی
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# === منابع دیتا — این‌ها را Next.js نمی‌خواند، فقط Edge Functionها ===
# با supabase secrets set --env-file بارگذاری می‌شوند، نه از این فایل به‌صورت خودکار
BRSAPI_KEY=

# === تلگرام — فاز ۵، برای Edge Function های evaluate-alerts/send-alert-digest ===
# ساخت بات: پیام به @BotFather در تلگرام → /newbot → توکن را بگیر
# chat id: به بات پیام بده، بعد getUpdates را چک کن یا از @userinfobot بپرس
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# لینک مستقیم داخل پیام‌های تلگرام — پیش‌فرض Edge Functionها اگر ست نشود همین آدرس production است
SITE_URL=https://bazar-bourse.vercel.app

# === گیت رمز مشترک کل سایت — proxy.ts + app/login ===
# پروژه تک‌کاربره/شخصی است و سیستم کاربر واقعی ندارد؛ این فقط برای اجازه دادن موقت به یک
# نفر دیگر (مثلاً یک دوست برای تست) بدون باز بودن کامل سایت روی اینترنت است.
# بدون این مقدار، proxy همه را رد می‌کند (fail-closed) — هم در .env.local و هم در Vercel لازم است.
SITE_PASSWORD=
